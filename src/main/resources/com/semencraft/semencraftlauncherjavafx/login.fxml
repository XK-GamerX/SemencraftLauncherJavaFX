<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
  Tarjeta dividida: formulario a la izquierda, imagen del juego en gris a la derecha.
  Los iconos de los campos son SVGPath encima del TextField (que deja sitio con padding).
-->
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:id="loginRoot"
           fx:controller="com.semencraft.semencraftlauncherjavafx.LoginController"
           maxWidth="Infinity"
           maxHeight="Infinity"
           styleClass="login-root">

    <Region fx:id="loginBackdrop" styleClass="login-backdrop" maxWidth="Infinity" maxHeight="Infinity"/>

    <ScrollPane fx:id="loginScroll"
                styleClass="login-scroll"
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                maxWidth="Infinity"
                maxHeight="Infinity">
        <content>
            <VBox fx:id="loginOuter"
                  alignment="CENTER"
                  maxWidth="Infinity"
                  maxHeight="Infinity">

                <HBox fx:id="loginCard" styleClass="login-card">

                    <VBox fx:id="loginFormPanel" styleClass="login-form-panel" alignment="CENTER">

                        <ImageView fx:id="imgLoginLogo" preserveRatio="true" smooth="true">
                            <VBox.margin><Insets bottom="30"/></VBox.margin>
                        </ImageView>

                        <!-- Iniciar sesion -->
                        <VBox fx:id="loginPane" spacing="12" maxWidth="Infinity">
                            <StackPane styleClass="login-field-box">
                                <TextField fx:id="txtLoginUsername" styleClass="login-field" promptText="Usuario de Minecraft" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT"
                                         content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20v-1c0-2.8 3.6-5 8-5s8 2.2 8 5v1z"/>
                            </StackPane>
                            <StackPane styleClass="login-field-box">
                                <PasswordField fx:id="txtLoginPassword" styleClass="login-field" promptText="Contraseña" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" fillRule="EVEN_ODD"
                                         content="M7 10V8a5 5 0 0 1 10 0v2h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM9 10h6V8a3 3 0 0 0-6 0z"/>
                            </StackPane>

                            <CheckBox fx:id="chkRememberMe" text="Recordarme" selected="true" styleClass="login-check"/>

                            <Label fx:id="lblLoginError" text="" styleClass="login-error-lbl" maxWidth="Infinity" wrapText="true"/>

                            <Button fx:id="btnLogin"
                                    text="ENTRAR"
                                    styleClass="login-green-btn"
                                    maxWidth="Infinity"
                                    onAction="#onLogin"/>

                            <HBox alignment="CENTER" spacing="4">
                                <Label text="¿No tienes cuenta?" styleClass="login-muted-lbl"/>
                                <Hyperlink fx:id="linkShowRegister"
                                           text="Regístrate"
                                           styleClass="login-switch-link"
                                           onAction="#onShowRegister"/>
                            </HBox>
                        </VBox>

                        <!-- Registro -->
                        <VBox fx:id="registerPane" spacing="12" maxWidth="Infinity" visible="false" managed="false">
                            <StackPane styleClass="login-field-box">
                                <TextField fx:id="txtRegisterMinecraftUser" styleClass="login-field" promptText="Nombre de Minecraft" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT"
                                         content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20v-1c0-2.8 3.6-5 8-5s8 2.2 8 5v1z"/>
                            </StackPane>
                            <StackPane styleClass="login-field-box">
                                <PasswordField fx:id="txtRegisterPassword" styleClass="login-field" promptText="Contraseña" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" fillRule="EVEN_ODD"
                                         content="M7 10V8a5 5 0 0 1 10 0v2h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM9 10h6V8a3 3 0 0 0-6 0z"/>
                            </StackPane>
                            <StackPane styleClass="login-field-box">
                                <PasswordField fx:id="txtRegisterPasswordRepeat" styleClass="login-field" promptText="Repite la contraseña" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" fillRule="EVEN_ODD"
                                         content="M7 10V8a5 5 0 0 1 10 0v2h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM9 10h6V8a3 3 0 0 0-6 0z"/>
                            </StackPane>
                            <StackPane styleClass="login-field-box">
                                <TextField fx:id="txtRegisterDiscordUser" styleClass="login-field" promptText="Usuario de Discord" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT"
                                         content="M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H10l-5 4v-4H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/>
                            </StackPane>

                            <Label fx:id="lblRegisterHint"
                                   text="Debe coincidir con tu usuario en el servidor de Discord."
                                   styleClass="login-note-lbl"
                                   maxWidth="Infinity"
                                   wrapText="true"/>

                            <Label fx:id="lblRegisterError" text="" styleClass="login-error-lbl" maxWidth="Infinity" wrapText="true"/>

                            <Button fx:id="btnRegister"
                                    text="CREAR CUENTA"
                                    styleClass="login-green-btn"
                                    maxWidth="Infinity"
                                    onAction="#onRegister"/>

                            <HBox alignment="CENTER" spacing="4">
                                <Label text="¿Ya tienes cuenta?" styleClass="login-muted-lbl"/>
                                <Hyperlink fx:id="linkShowLogin"
                                           text="Inicia sesión"
                                           styleClass="login-switch-link"
                                           onAction="#onShowLogin"/>
                            </HBox>
                        </VBox>

                        <!-- Codigo de Discord -->
                        <VBox fx:id="verificationPane" spacing="12" maxWidth="Infinity" visible="false" managed="false">
                            <Label fx:id="lblVerificationHint"
                                   text="Revisa tus MDs en Discord y escribe aquí tu código temporal."
                                   styleClass="login-note-lbl"
                                   maxWidth="Infinity"
                                   wrapText="true"/>

                            <StackPane styleClass="login-field-box">
                                <TextField fx:id="txtVerificationCode" styleClass="login-field" promptText="Código de 6 dígitos" maxWidth="Infinity"/>
                                <SVGPath styleClass="login-field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT" fillRule="EVEN_ODD"
                                         content="M15 3a6 6 0 0 0-5.7 7.9L3 17.2V21h3.8v-2h2v-2h2l1.3-1.3A6 6 0 1 0 15 3zM16.5 6a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/>
                            </StackPane>

                            <Label fx:id="lblVerificationError" text="" styleClass="login-error-lbl" maxWidth="Infinity" wrapText="true"/>

                            <Button fx:id="btnVerifyCode"
                                    text="VERIFICAR"
                                    styleClass="login-green-btn"
                                    maxWidth="Infinity"
                                    onAction="#onVerifyCode"/>

                            <HBox alignment="CENTER">
                                <Hyperlink fx:id="linkBackToRegister"
                                           text="Volver y corregir mis datos"
                                           styleClass="login-switch-link"
                                           onAction="#onBackToRegister"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <StackPane fx:id="loginArt" styleClass="login-art" HBox.hgrow="ALWAYS" minWidth="0">
                        <ImageView fx:id="imgLoginArt" preserveRatio="false" smooth="true"/>
                        <Region styleClass="login-art-shade" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>
                    </StackPane>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>

</StackPane>
