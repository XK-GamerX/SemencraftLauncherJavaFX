<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.semencraft.semencraftlauncherjavafx.LauncherController"
            styleClass="launcher-root">

    <top>
        <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_LEFT">
            <HBox fx:id="titleBarDragArea" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <ImageView fx:id="imgTitleBarIcon" fitHeight="18" preserveRatio="true" smooth="true">
                    <HBox.margin><Insets left="8" right="8"/></HBox.margin>
                </ImageView>
                <Label text="SemenCraft Launcher" styleClass="title-label"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button fx:id="btnMinimize" styleClass="win-btn" text="_" focusTraversable="false" mnemonicParsing="false" onAction="#onMinimize"/>
            <Button fx:id="btnMaxRestore" styleClass="win-btn" text="□" focusTraversable="false" mnemonicParsing="false" onAction="#onMaxRestore"/>
            <Button fx:id="btnClose" styleClass="win-btn-close" text="X" focusTraversable="false" mnemonicParsing="false" onAction="#onClose"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="centerRoot" maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0">
            <Region styleClass="app-background" maxWidth="Infinity" maxHeight="Infinity"/>

            <HBox maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0" spacing="0">
                <StackPane fx:id="sidebarGlass"
                           styleClass="sidebar-glass"
                           minWidth="212"
                           prefWidth="262"
                           maxWidth="262">
                    <Region fx:id="sidebarBlurLayer" styleClass="sidebar-blur-layer" maxWidth="Infinity" maxHeight="Infinity"/>
                    <Region styleClass="sidebar-dark-overlay" maxWidth="Infinity" maxHeight="Infinity"/>

                    <ScrollPane fx:id="sidebarScroll"
                                styleClass="sidebar-scroll"
                                fitToWidth="true"
                                fitToHeight="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="NEVER"
                                maxWidth="Infinity"
                                maxHeight="Infinity">
                        <content>
                            <VBox fx:id="sidebar"
                                  styleClass="sidebar"
                                  fillWidth="true"
                                  prefWidth="262"
                                  minWidth="212"
                                  maxWidth="262">

                                <HBox alignment="CENTER">
                                    <VBox.margin><Insets top="20" bottom="10"/></VBox.margin>
                                    <ImageView fx:id="imgLogo" fitHeight="96" preserveRatio="true" smooth="true"/>
                                </HBox>

                                <Region styleClass="sidebar-divider" prefHeight="1" maxWidth="Infinity">
                                    <VBox.margin><Insets left="16" right="16" bottom="14"/></VBox.margin>
                                </Region>

                                <VBox styleClass="nav-box canvas-9patch">
                                    <VBox.margin><Insets left="10" right="10"/></VBox.margin>
                                    <Button fx:id="btnNavHome" styleClass="nav-btn" maxWidth="Infinity" onAction="#onHome"/>
                                    <Button fx:id="btnNavSkin" styleClass="nav-btn" maxWidth="Infinity" onAction="#onSkin"/>
                                    <Button fx:id="btnNavTeam" styleClass="nav-btn" maxWidth="Infinity" onAction="#onTeam"/>
                                    <Button fx:id="btnNavSettings" styleClass="nav-btn" maxWidth="Infinity" onAction="#onSettings"/>
                                </VBox>

                                <Pane fx:id="semmiePane" prefHeight="115" maxWidth="Infinity">
                                    <VBox.margin><Insets top="12"/></VBox.margin>
                                    <ImageView fx:id="imgSemmie"
                                               fitWidth="90"
                                               fitHeight="90"
                                               layoutX="-90"
                                               layoutY="16"
                                               preserveRatio="true"/>
                                </Pane>

                                <Region VBox.vgrow="ALWAYS"/>

                                <Label fx:id="lblStatus"
                                       text="Listo para jugar"
                                       styleClass="status-label sidebar-status-label"
                                       visible="false"
                                       managed="false"
                                       maxWidth="Infinity"
                                       wrapText="true">
                                    <VBox.margin><Insets left="10" right="10" bottom="8"/></VBox.margin>
                                </Label>

                                <HBox styleClass="user-box" alignment="CENTER_LEFT" spacing="12">
                                    <VBox.margin><Insets left="10" right="10" bottom="8"/></VBox.margin>
                                    <StackPane fx:id="currentUserAvatar"
                                               prefWidth="54"
                                               prefHeight="54"
                                               minWidth="54"
                                               minHeight="54"
                                               maxWidth="54"
                                               maxHeight="54"/>
                                    <VBox spacing="4" alignment="CENTER_LEFT">
                                        <Label text="USUARIO ACTUAL" styleClass="section-label"/>
                                        <Label fx:id="lblUsername"
                                               text="--"
                                               styleClass="username-label"
                                               maxWidth="Infinity"/>
                                    </VBox>
                                </HBox>

                                <Button fx:id="btnDiscord"
                                        styleClass="discord-btn"
                                        maxWidth="Infinity"
                                        onAction="#onDiscord">
                                    <VBox.margin><Insets left="10" right="10" bottom="8"/></VBox.margin>
                                </Button>

                                <Label text="v1.0.3  -  Fabric 1.21.1" styleClass="version-label" maxWidth="Infinity">
                                    <VBox.margin><Insets left="10" right="10" bottom="14"/></VBox.margin>
                                </Label>
                            </VBox>
                        </content>
                    </ScrollPane>
                </StackPane>

                <StackPane fx:id="centerLayer" HBox.hgrow="ALWAYS" minWidth="0" minHeight="0">
                    <Region styleClass="center-vignette center-vignette-left" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>
                    <Region styleClass="center-vignette center-vignette-top" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>
                    <Region styleClass="center-vignette center-vignette-bottom" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

                    <VBox fx:id="centerContent" alignment="CENTER" pickOnBounds="false" minHeight="0">
                        <padding><Insets top="22" right="30" bottom="24" left="30"/></padding>
                        <ImageView fx:id="imgTitle" fitHeight="250" preserveRatio="true" smooth="true"/>
                        <Region fx:id="titleGap" prefHeight="16"/>
                        <StackPane>
                            <ImageView fx:id="imgPlayBtn"
                                       fitWidth="180"
                                       fitHeight="180"
                                       managed="false"
                                       visible="false"
                                       preserveRatio="true"
                                       smooth="false"/>
                            <Button fx:id="btnPlay" text="JUGAR" styleClass="play-btn" onAction="#onPlay"/>
                        </StackPane>
                        <Region fx:id="statusGap" prefHeight="14"/>
                    </VBox>

                    <VBox fx:id="settingsView"
                          styleClass="settings-view"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          maxHeight="Infinity">
                        <HBox styleClass="settings-top-tabs" alignment="CENTER_LEFT" spacing="8">
                            <padding><Insets top="14" right="14" bottom="10" left="14"/></padding>
                            <Button fx:id="btnSettingsTabGeneral"
                                    text="General"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabGeneral"/>
                            <Button fx:id="btnSettingsTabModpacks"
                                    text="Modpacks"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabModpacks"/>
                            <Button fx:id="btnSettingsTabResourcepacks"
                                    text="Packs de textura"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabResourcepacks"/>
                            <Button fx:id="btnSettingsTabSystem"
                                    text="Sistema"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabSystem"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblJavaRuntimeStatus" text="Java: verificando..." styleClass="java-status-label"/>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <ScrollPane fx:id="settingsScroll"
                                        styleClass="settings-scroll"
                                        fitToWidth="true"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="AS_NEEDED"
                                        maxWidth="Infinity"
                                        maxHeight="Infinity">
                                <content>
                                    <VBox fx:id="settingsRoot" styleClass="settings-root" spacing="16">
                                        <padding><Insets top="14" right="18" bottom="112" left="18"/></padding>

                                        <Label text="Configuracion del Launcher (Fabric)" styleClass="settings-title"/>
                                        <Label text="Gestiona tu perfil de juego, mods, resourcepacks aprobados y requisitos del sistema."
                                               styleClass="settings-subtitle"
                                               wrapText="true"/>

                                        <VBox fx:id="paneSettingsGeneral" styleClass="settings-section" spacing="10">
                                            <Label text="Lanzamiento y rendimiento" styleClass="settings-section-title"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="RAM asignada" styleClass="settings-field-label"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblRamValue" text="6 GB" styleClass="settings-value"/>
                                            </HBox>
                                            <Slider fx:id="sliderRam" min="2" max="16" value="6" majorTickUnit="2" minorTickCount="1" blockIncrement="1"/>

                                            <Label text="Modo de ventana" styleClass="settings-field-label"/>
                                            <ComboBox fx:id="cmbLaunchMode" styleClass="settings-combo" maxWidth="Infinity"/>

                                            <Label text="Resolucion (solo ventana)" styleClass="settings-field-label"/>
                                            <TextField fx:id="txtResolution"
                                                       styleClass="settings-field"
                                                       promptText="1280x720"/>

                                            <CheckBox fx:id="chkBorderlessWindow"
                                                      text="Usar ventana sin bordes (borderless)"
                                                      styleClass="settings-check"/>
                                            <CheckBox fx:id="chkCloseLauncherOnStart"
                                                      text="Cerrar launcher al iniciar el juego"
                                                      styleClass="settings-check"/>
                                            <CheckBox fx:id="chkDiscordRpc"
                                                      text="Activar Discord RPC"
                                                      styleClass="settings-check"/>
                                        </VBox>

                                        <VBox fx:id="paneSettingsModpacks" styleClass="settings-section" spacing="12">
                                            <Label text="Plantilla de modpack" styleClass="settings-section-title"/>
                                            <Label text="Normal: todo activado. Optimizada: desactiva secciones pesadas y aplica parche de opciones."
                                                   styleClass="settings-hint"
                                                   wrapText="true"/>
                                            <ComboBox fx:id="cmbModpack" styleClass="settings-combo" maxWidth="Infinity"/>

                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <TextField fx:id="txtModSearch"
                                                           promptText="Buscar mod por nombre..."
                                                           styleClass="settings-field"
                                                           HBox.hgrow="ALWAYS"/>
                                            </HBox>

                                            <VBox spacing="8" alignment="CENTER_LEFT">
                                                <Label text="Secciones" styleClass="mod-filter-label"/>
                                                <FlowPane fx:id="modsSectionFilterChips"
                                                          hgap="8"
                                                          vgap="8"
                                                          prefWrapLength="720"
                                                          maxWidth="Infinity"/>
                                            </VBox>

                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label fx:id="lblModsCount" text="0 elementos" styleClass="settings-hint"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button fx:id="btnModsPrevPage" text="Anterior" styleClass="mod-page-btn" onAction="#onModsPrevPage"/>
                                                <Label fx:id="lblModsPage" text="Pagina 1/1" styleClass="settings-value"/>
                                                <Button fx:id="btnModsNextPage" text="Siguiente" styleClass="mod-page-btn" onAction="#onModsNextPage"/>
                                            </HBox>

                                            <VBox fx:id="modsListContainer" styleClass="mods-list" spacing="8"/>
                                        </VBox>

                                        <VBox fx:id="paneSettingsResourcepacks"
                                              styleClass="settings-section resourcepacks-section"
                                              spacing="14"
                                              visible="false"
                                              managed="false">
                                            <Label text="Editor de paquetes de recursos" styleClass="settings-section-title"/>
                                            <Label text="Mueve a Activos los packs que quieras usar en el juego. Aqui solo aparecen los aprobados por Semencraft."
                                                   styleClass="settings-hint"
                                                   wrapText="true"/>

                                            <HBox styleClass="resourcepack-editor" spacing="14">
                                                <VBox styleClass="resourcepack-column" spacing="10" HBox.hgrow="ALWAYS">
                                                    <Label text="Disponibles" styleClass="resourcepack-column-title"/>
                                                    <VBox fx:id="resourcepacksAvailableContainer" styleClass="resourcepack-list" spacing="10"/>
                                                </VBox>
                                                <VBox styleClass="resourcepack-column" spacing="10" HBox.hgrow="ALWAYS">
                                                    <Label text="Activos" styleClass="resourcepack-column-title"/>
                                                    <VBox fx:id="resourcepacksSelectedContainer" styleClass="resourcepack-list" spacing="10"/>
                                                </VBox>
                                            </HBox>
                                        </VBox>

                                        <VBox fx:id="paneSettingsSystem" styleClass="settings-section" spacing="8">
                                            <Label text="Estado del sistema" styleClass="settings-section-title"/>
                                            <Label fx:id="lblSystemJavaDetails"
                                                   text="Java: verificando version requerida..."
                                                   styleClass="settings-hint"
                                                   wrapText="true"/>
                                            <Label text="Para Minecraft 1.21.1 se recomienda Java 21 o superior."
                                                   styleClass="settings-hint"
                                                   wrapText="true"/>
                                        </VBox>
                                    </VBox>
                                </content>
                            </ScrollPane>

                            <HBox fx:id="settingsActionBar"
                                  styleClass="settings-action-bar"
                                  spacing="10"
                                  alignment="CENTER_LEFT"
                                  StackPane.alignment="BOTTOM_CENTER">
                                <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
                                <Button fx:id="btnSaveSettings"
                                        text="Guardar cambios"
                                        styleClass="settings-save-btn"
                                        onAction="#onSaveSettings"/>
                                <Button fx:id="btnDiscardSettings"
                                        text="Descartar"
                                        styleClass="settings-discard-btn"
                                        onAction="#onDiscardSettings"/>
                                <Label fx:id="lblSettingsStatus" text="" styleClass="settings-status"/>
                            </HBox>
                        </StackPane>
                    </VBox>

                    <VBox fx:id="skinView"
                          styleClass="menu-dark-bg"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          maxHeight="Infinity">
                        <ScrollPane fx:id="skinScroll"
                                    styleClass="skin-scroll"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity">
                            <content>
                                <VBox fx:id="skinRoot" styleClass="skin-root" spacing="18">
                                    <padding><Insets top="22" right="18" bottom="40" left="18"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox fx:id="teamView"
                          styleClass="menu-dark-bg"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          maxHeight="Infinity">
                        <ScrollPane fx:id="teamScroll"
                                    styleClass="team-scroll"
                                    fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity">
                            <content>
                                <VBox fx:id="teamRoot" styleClass="team-root" spacing="18">
                                    <padding><Insets top="22" right="18" bottom="40" left="18"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <StackPane fx:id="loadingOverlay" visible="false" opacity="0">
                        <Region styleClass="loading-backdrop" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

                        <VBox fx:id="loadingCard"
                              alignment="CENTER"
                              spacing="18"
                              pickOnBounds="false"
                              styleClass="loading-card">
                            <ImageView fx:id="imgLoadTitle" fitHeight="120" preserveRatio="true" smooth="true"/>
                            <Label fx:id="lblLoadStatus" text="Iniciando..." styleClass="load-status-text"/>

                            <VBox alignment="CENTER" spacing="14">
                                <VBox spacing="6">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="PROGRESO TOTAL" styleClass="progress-head-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblTotalPercent" text="0%" styleClass="progress-percent-label"/>
                                    </HBox>
                                    <StackPane fx:id="progressTrackTotal" styleClass="progress-track" prefHeight="12" prefWidth="390">
                                        <Region fx:id="progressFillTotal"
                                                styleClass="progress-fill progress-fill-total"
                                                prefHeight="12"
                                                prefWidth="0"
                                                StackPane.alignment="CENTER_LEFT"/>
                                    <Region fx:id="progressIndTotal"
                                            styleClass="progress-indicator progress-indicator-total"
                                            prefWidth="74"
                                            prefHeight="8"
                                            StackPane.alignment="CENTER_LEFT"/>
                                    </StackPane>
                                </VBox>

                                <VBox spacing="6">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="DESCARGA ACTUAL" styleClass="progress-head-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblDownloadPercent" text="0%" styleClass="progress-percent-label"/>
                                    </HBox>
                                    <StackPane fx:id="progressTrackDownload" styleClass="progress-track" prefHeight="12" prefWidth="390">
                                        <Region fx:id="progressFillDownload"
                                                styleClass="progress-fill progress-fill-download"
                                                prefHeight="12"
                                                prefWidth="0"
                                                StackPane.alignment="CENTER_LEFT"/>
                                    <Region fx:id="progressIndDownload"
                                            styleClass="progress-indicator progress-indicator-download"
                                            prefWidth="74"
                                            prefHeight="8"
                                            StackPane.alignment="CENTER_LEFT"/>
                                    </StackPane>
                                </VBox>

                                <HBox fx:id="timerRow" prefWidth="390" alignment="CENTER_LEFT">
                                    <Label fx:id="lblTimer" styleClass="timer-label"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </StackPane>

                                <fx:include fx:id="login" source="login.fxml"/>
                </StackPane>
            </HBox>

            <AnchorPane pickOnBounds="false" maxWidth="Infinity" maxHeight="Infinity">
                <StackPane fx:id="notificationsAnchor"
                           pickOnBounds="false"
                           AnchorPane.topAnchor="14.0"
                           AnchorPane.rightAnchor="18.0">
                    <Button fx:id="btnNotifications"
                            styleClass="notification-bell-btn"
                            onAction="#onToggleNotifications"/>
                    <StackPane fx:id="notificationBadge"
                               styleClass="notification-badge"
                               visible="false"
                               managed="false"
                               mouseTransparent="true"
                               StackPane.alignment="TOP_RIGHT"
                               scaleX="0.34"
                               scaleY="0.34"
                               translateX="11"
                               translateY="-11">
                        <Label fx:id="lblNotificationCount"
                               text="0"
                               styleClass="notification-badge-label"/>
                    </StackPane>
                </StackPane>

                <StackPane fx:id="notificationsDropdown"
                           visible="false"
                           managed="false"
                           pickOnBounds="false"
                           AnchorPane.topAnchor="50.0"
                           AnchorPane.rightAnchor="18.0">
                    <StackPane prefWidth="334"
                               prefHeight="422"
                               maxWidth="334"
                               maxHeight="422"
                               styleClass="notifications-shell">
                        <ImageView fx:id="imgNotificationsBook"
                                   fitWidth="334"
                                   fitHeight="422"
                                   preserveRatio="false"
                                   smooth="false"/>
                        <BorderPane prefWidth="334"
                                    prefHeight="422"
                                    maxWidth="334"
                                    maxHeight="422"
                                    styleClass="notifications-surface">
                            <top>
                                <HBox alignment="CENTER_RIGHT">
                                    <padding><Insets top="26" right="22" bottom="0" left="24"/></padding>
                                    <Button fx:id="btnCloseNotifications"
                                            text="X"
                                            styleClass="notifications-close-btn"
                                            onAction="#onCloseNotifications"/>
                                </HBox>
                            </top>
                            <center>
                                <ScrollPane fx:id="notificationsScroll"
                                            styleClass="notifications-scroll"
                                            fitToWidth="true"
                                            hbarPolicy="NEVER"
                                            vbarPolicy="AS_NEEDED"
                                            prefViewportWidth="252"
                                            prefViewportHeight="300">
                                    <BorderPane.margin><Insets top="12" right="20" bottom="24" left="28"/></BorderPane.margin>
                                    <content>
                                        <VBox fx:id="notificationsList"
                                              styleClass="notifications-list"
                                              spacing="10"
                                              maxWidth="Infinity">
                                            <padding><Insets top="4" right="6" bottom="8" left="6"/></padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </center>
                        </BorderPane>
                    </StackPane>
                </StackPane>
            </AnchorPane>

            <StackPane fx:id="startupOverlay" styleClass="startup-overlay" maxWidth="Infinity" maxHeight="Infinity" visible="false" managed="false">
                <VBox alignment="CENTER" spacing="12" maxWidth="Infinity" maxHeight="Infinity">
                    <Label fx:id="lblStartupStatus" text="Cargando Launcher" styleClass="startup-title"/>
                    <StackPane fx:id="startupProgressTrack" styleClass="startup-progress-track" prefWidth="260" prefHeight="10">
                        <Region fx:id="startupProgressFill"
                                styleClass="startup-progress-fill"
                                prefHeight="10"
                                prefWidth="0"
                                StackPane.alignment="CENTER_LEFT"/>
                    </StackPane>
                    <Label fx:id="lblStartupPercent" text="0%" styleClass="startup-percent"/>
                </VBox>
            </StackPane>
        </StackPane>
    </center>

</BorderPane>
