<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.semencraft.semencraftlauncherjavafx.LauncherController"
            styleClass="launcher-root">

    <top>
        <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_LEFT">
            <HBox fx:id="titleBarDragArea" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <ImageView fx:id="imgTitleBarIcon" fitHeight="18" preserveRatio="true" smooth="true"/>
                <Label text="Semencraft Launcher" styleClass="title-label"/>
                <Label fx:id="lblTitleVersion" text="v1.0" styleClass="title-version-chip"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button fx:id="btnMinimize" styleClass="win-btn" focusTraversable="false" mnemonicParsing="false" onAction="#onMinimize"/>
            <Button fx:id="btnMaxRestore" styleClass="win-btn" focusTraversable="false" mnemonicParsing="false" onAction="#onMaxRestore"/>
            <Button fx:id="btnClose" styleClass="win-btn, win-btn-close" focusTraversable="false" mnemonicParsing="false" onAction="#onClose"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="centerRoot" maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0">
            <Region styleClass="app-background" maxWidth="Infinity" maxHeight="Infinity"/>
            <Region styleClass="app-background-tint" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

            <HBox maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0" spacing="0">
                <StackPane fx:id="sidebarGlass"
                           styleClass="sidebar-glass"
                           minWidth="72"
                           prefWidth="72"
                           maxWidth="72">
                    <Region fx:id="sidebarBlurLayer" styleClass="sidebar-blur-layer" maxWidth="Infinity" maxHeight="Infinity"/>

                    <ScrollPane fx:id="sidebarScroll"
                                styleClass="sidebar-scroll"
                                fitToWidth="true"
                                fitToHeight="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="NEVER"
                                maxWidth="Infinity"
                                maxHeight="Infinity">
                        <content>
                            <VBox fx:id="sidebar"
                                  styleClass="sidebar"
                                  alignment="TOP_CENTER"
                                  prefWidth="72"
                                  minWidth="72"
                                  maxWidth="72">

                                <StackPane styleClass="rail-logo">
                                    <ImageView fx:id="imgLogo" fitWidth="30" fitHeight="30" preserveRatio="true" smooth="true"/>
                                </StackPane>

                                <VBox styleClass="nav-box" spacing="8" alignment="TOP_CENTER">
                                    <Button fx:id="btnNavHome" styleClass="nav-btn" onAction="#onHome"/>
                                    <Button fx:id="btnNavSkin" styleClass="nav-btn" onAction="#onSkin"/>
                                    <Button fx:id="btnNavTeam" styleClass="nav-btn" onAction="#onTeam"/>
                                    <Button fx:id="btnNavSettings" styleClass="nav-btn" onAction="#onSettings"/>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS"/>

                                <Label fx:id="lblStatus"
                                       text="Listo para jugar"
                                       styleClass="status-label"
                                       visible="false"
                                       managed="false"/>
                            </VBox>
                        </content>
                    </ScrollPane>
                </StackPane>

                <StackPane fx:id="centerLayer" HBox.hgrow="ALWAYS" minWidth="0" minHeight="0">
                    <Region styleClass="center-vignette" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

                    <VBox styleClass="content-column" maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0">
                        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="20">
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox fx:id="userBlock" styleClass="user-block" alignment="CENTER_RIGHT" spacing="12">
                                <VBox spacing="1" alignment="CENTER_RIGHT">
                                    <Label fx:id="lblUsername" text="--" styleClass="username-label"/>
                                    <HBox spacing="6" alignment="CENTER_RIGHT">
                                        <Region fx:id="userStateDot" styleClass="user-state-dot"/>
                                        <Label fx:id="lblUserState" text="Sin sesión" styleClass="user-state-label"/>
                                    </HBox>
                                </VBox>
                                <StackPane fx:id="currentUserAvatar"
                                           prefWidth="40"
                                           prefHeight="40"
                                           minWidth="40"
                                           minHeight="40"
                                           maxWidth="40"
                                           maxHeight="40"/>
                            </HBox>
                            <Region minWidth="48" prefWidth="48" maxWidth="48"/>
                        </HBox>

                        <StackPane fx:id="viewStack" VBox.vgrow="ALWAYS" minWidth="0" minHeight="0">
                            <VBox fx:id="centerContent" styleClass="hero" alignment="CENTER" pickOnBounds="false" minHeight="0" maxWidth="Infinity" spacing="0">
                                <ImageView fx:id="imgTitle" fitHeight="220" preserveRatio="true" smooth="true" styleClass="hero-logo"/>
                                <Region fx:id="titleGap" prefHeight="30"/>
                                <HBox spacing="10" alignment="CENTER">
                                    <Button fx:id="btnPlay" text="JUGAR" styleClass="play-btn" onAction="#onPlay"/>
                                    <Button fx:id="btnConfigure" text="CONFIGURAR" styleClass="text-btn" onAction="#onConfigure"/>
                                </HBox>
                            </VBox>

                    <VBox fx:id="settingsView"
                          styleClass="page-view"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          maxHeight="Infinity">
                        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
                            <Label text="Configuración" styleClass="page-title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblJavaRuntimeStatus" text="Java: verificando..." styleClass="java-status-label"/>
                        </HBox>

                        <HBox styleClass="settings-top-tabs" alignment="CENTER_LEFT" spacing="4">
                            <Button fx:id="btnSettingsTabGeneral"
                                    text="General"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabGeneral"/>
                            <Button fx:id="btnSettingsTabModpacks"
                                    text="Modpacks"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabModpacks"/>
                            <Button fx:id="btnSettingsTabResourcepacks"
                                    text="Packs de textura"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabResourcepacks"/>
                            <Button fx:id="btnSettingsTabSystem"
                                    text="Sistema"
                                    styleClass="settings-tab-btn"
                                    onAction="#onSettingsTabSystem"/>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <ScrollPane fx:id="settingsScroll"
                                        styleClass="settings-scroll"
                                        fitToWidth="true"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="AS_NEEDED"
                                        maxWidth="Infinity"
                                        maxHeight="Infinity">
                                <content>
                                    <VBox fx:id="settingsRoot" styleClass="settings-root" spacing="16">
                                        <padding><Insets top="18" right="28" bottom="112" left="40"/></padding>

                                        <VBox fx:id="paneSettingsGeneral" styleClass="settings-section" spacing="0">
                                            <Label text="Lanzamiento y rendimiento" styleClass="settings-section-title"/>

                                            <VBox styleClass="setting-row" spacing="10">
                                                <HBox spacing="10" alignment="CENTER_LEFT">
                                                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                        <Label text="Memoria RAM" styleClass="settings-field-label"/>
                                                        <Label text="Entre 4 y 8 GB va bien. No uses más de la mitad de la RAM de tu PC."
                                                               styleClass="settings-hint" wrapText="true"/>
                                                    </VBox>
                                                    <Label fx:id="lblRamValue" text="6 GB" styleClass="settings-value-chip"/>
                                                </HBox>
                                                <Slider fx:id="sliderRam" min="2" max="16" value="6" majorTickUnit="2" minorTickCount="1" blockIncrement="1" styleClass="ram-slider"/>
                                            </VBox>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Modo de ventana" styleClass="settings-field-label"/>
                                                </VBox>
                                                <ComboBox fx:id="cmbLaunchMode" styleClass="settings-combo" prefWidth="240"/>
                                            </HBox>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Resolución" styleClass="settings-field-label"/>
                                                    <Label text="Solo en modo ventana, por ejemplo 1280x720." styleClass="settings-hint"/>
                                                </VBox>
                                                <TextField fx:id="txtResolution"
                                                           styleClass="settings-field"
                                                           prefWidth="240"
                                                           promptText="1280x720"/>
                                            </HBox>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Ventana sin bordes" styleClass="settings-field-label"/>
                                                </VBox>
                                                <CheckBox fx:id="chkBorderlessWindow" styleClass="settings-check"/>
                                            </HBox>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Cerrar el launcher al jugar" styleClass="settings-field-label"/>
                                                </VBox>
                                                <CheckBox fx:id="chkCloseLauncherOnStart" styleClass="settings-check"/>
                                            </HBox>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Discord Rich Presence" styleClass="settings-field-label"/>
                                                </VBox>
                                                <CheckBox fx:id="chkDiscordRpc" styleClass="settings-check"/>
                                            </HBox>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Sonido de notificaciones" styleClass="settings-field-label"/>
                                                </VBox>
                                                <CheckBox fx:id="chkNotificationSound" styleClass="settings-check"/>
                                            </HBox>

                                            <HBox styleClass="setting-row, setting-row-last" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Optimizar launcher" styleClass="settings-field-label"/>
                                                    <Label text="Quita animaciones, desenfoques y sombras. Recomendado en PCs o laptops modestas."
                                                           styleClass="settings-hint" wrapText="true"/>
                                                </VBox>
                                                <CheckBox fx:id="chkPerformanceMode" styleClass="settings-check"/>
                                            </HBox>
                                        </VBox>

                                        <VBox fx:id="paneSettingsModpacks" styleClass="settings-section" spacing="12">
                                            <Label text="Plantilla de modpack" styleClass="settings-section-title"/>
                                            <Label text="Normal: todo activado. Optimizada: desactiva lo más pesado y aplica un parche de opciones (una sola vez por jugador). Custom: tú eliges."
                                                   styleClass="settings-section-subtitle"
                                                   wrapText="true"/>
                                            <ComboBox fx:id="cmbModpack" styleClass="settings-combo" maxWidth="Infinity"/>

                                            <TextField fx:id="txtModSearch"
                                                       promptText="Buscar mod por nombre..."
                                                       styleClass="settings-field, search-field"
                                                       maxWidth="Infinity"/>

                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <FlowPane fx:id="modsSectionFilterChips"
                                                          hgap="8"
                                                          vgap="8"
                                                          prefWrapLength="720"
                                                          HBox.hgrow="ALWAYS"
                                                          maxWidth="Infinity"/>
                                            </HBox>

                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label fx:id="lblModsCount" text="0 elementos" styleClass="settings-hint"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button fx:id="btnModsPrevPage" text="‹" styleClass="mod-page-btn" onAction="#onModsPrevPage"/>
                                                <Label fx:id="lblModsPage" text="Página 1/1" styleClass="settings-value"/>
                                                <Button fx:id="btnModsNextPage" text="›" styleClass="mod-page-btn" onAction="#onModsNextPage"/>
                                            </HBox>

                                            <VBox fx:id="modsListContainer" styleClass="mods-list" spacing="6"/>
                                        </VBox>

                                        <VBox fx:id="paneSettingsResourcepacks"
                                              styleClass="settings-section, resourcepacks-section"
                                              spacing="14"
                                              visible="false"
                                              managed="false">
                                            <Label text="Packs de textura" styleClass="settings-section-title"/>
                                            <Label text="Mueve a Activos los packs que quieras usar. El orden importa: el de arriba tiene prioridad. Solo aparecen los aprobados por Semencraft."
                                                   styleClass="settings-section-subtitle"
                                                   wrapText="true"/>

                                            <HBox styleClass="resourcepack-editor" spacing="14">
                                                <VBox styleClass="resourcepack-column" spacing="10" HBox.hgrow="ALWAYS">
                                                    <Label text="Disponibles" styleClass="resourcepack-column-title"/>
                                                    <VBox fx:id="resourcepacksAvailableContainer" styleClass="resourcepack-list" spacing="8"/>
                                                </VBox>
                                                <VBox styleClass="resourcepack-column" spacing="10" HBox.hgrow="ALWAYS">
                                                    <Label text="Activos" styleClass="resourcepack-column-title"/>
                                                    <VBox fx:id="resourcepacksSelectedContainer" styleClass="resourcepack-list" spacing="8"/>
                                                </VBox>
                                            </HBox>
                                        </VBox>

                                        <VBox fx:id="paneSettingsSystem" styleClass="settings-section" spacing="0">
                                            <Label text="Estado del sistema" styleClass="settings-section-title"/>

                                            <HBox styleClass="setting-row" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label text="Java" styleClass="settings-field-label"/>
                                                    <Label fx:id="lblSystemJavaDetails"
                                                           text="Java: verificando versión requerida..."
                                                           styleClass="settings-hint"
                                                           wrapText="true"/>
                                                    <Label text="Minecraft 1.21.1 necesita Java 21 o superior (el launcher lo descarga solo si falta)."
                                                           styleClass="settings-hint"
                                                           wrapText="true"/>
                                                </VBox>
                                            </HBox>

                                            <HBox styleClass="setting-row, setting-row-last" spacing="16" alignment="CENTER_LEFT">
                                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                    <Label fx:id="lblLauncherVersion" text="Semencraft Launcher" styleClass="settings-field-label"/>
                                                    <Label fx:id="lblUpdateStatus" text="Busca nuevas versiones en GitHub." styleClass="settings-hint" wrapText="true"/>
                                                </VBox>
                                                <Button fx:id="btnCheckUpdates" text="Buscar actualizaciones" styleClass="secondary-btn" onAction="#onCheckUpdates"/>
                                            </HBox>
                                        </VBox>
                                    </VBox>
                                </content>
                            </ScrollPane>

                            <HBox fx:id="settingsActionBar"
                                  styleClass="settings-action-bar"
                                  spacing="10"
                                  alignment="CENTER_LEFT"
                                  StackPane.alignment="BOTTOM_CENTER">
                                <Label text="Cambios sin guardar" styleClass="settings-action-hint"/>
                                <Label fx:id="lblSettingsStatus" text="" styleClass="settings-status"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnDiscardSettings"
                                        text="Descartar"
                                        styleClass="settings-discard-btn"
                                        onAction="#onDiscardSettings"/>
                                <Button fx:id="btnSaveSettings"
                                        text="Guardar cambios"
                                        styleClass="settings-save-btn"
                                        onAction="#onSaveSettings"/>
                            </HBox>
                        </StackPane>
                    </VBox>

                    <VBox fx:id="skinView"
                          styleClass="page-view"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          maxHeight="Infinity">
                        <ScrollPane fx:id="skinScroll"
                                    styleClass="skin-scroll"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity">
                            <content>
                                <VBox fx:id="skinRoot" styleClass="skin-root" spacing="18">
                                    <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox fx:id="teamView"
                          styleClass="page-view"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          maxHeight="Infinity">
                        <ScrollPane fx:id="teamScroll"
                                    styleClass="team-scroll"
                                    fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity">
                            <content>
                                <VBox fx:id="teamRoot" styleClass="team-root" spacing="18">
                                    <padding><Insets top="26" right="28" bottom="40" left="28"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                        </StackPane>

                        <HBox styleClass="bottom-bar" alignment="CENTER_LEFT" spacing="16">
                            <Button fx:id="btnModsList" text="LISTA DE MODS" styleClass="text-btn, text-btn-small" onAction="#onModsList"/>
                            <Region HBox.hgrow="ALWAYS" minWidth="0" prefHeight="62" minHeight="62"/>
                            <Button fx:id="btnDiscord" styleClass="text-btn, text-btn-small" onAction="#onDiscord"/>
                            <Label fx:id="lblVersion" text="v1.0  -  Fabric 1.21.1" styleClass="version-label"/>
                        </HBox>
                    </VBox>

                    <StackPane fx:id="loadingOverlay" visible="false" opacity="0">
                        <Region styleClass="loading-backdrop" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true"/>

                        <VBox fx:id="loadingCard"
                              alignment="CENTER"
                              spacing="18"
                              pickOnBounds="false"
                              styleClass="loading-card">
                            <ImageView fx:id="imgLoadTitle" fitHeight="110" preserveRatio="true" smooth="true"/>
                            <Label fx:id="lblLoadStatus" text="Iniciando..." styleClass="load-status-text" wrapText="true"/>

                            <VBox alignment="CENTER" spacing="16">
                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="PROGRESO TOTAL" styleClass="progress-head-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblTotalPercent" text="0%" styleClass="progress-percent-label"/>
                                    </HBox>
                                    <StackPane fx:id="progressTrackTotal" styleClass="progress-track" prefHeight="8" prefWidth="390">
                                        <Region fx:id="progressFillTotal"
                                                styleClass="progress-fill, progress-fill-total"
                                                prefHeight="8"
                                                prefWidth="0"
                                                StackPane.alignment="CENTER_LEFT"/>
                                        <Region fx:id="progressIndTotal"
                                                styleClass="progress-indicator"
                                                prefWidth="74"
                                                prefHeight="6"
                                                StackPane.alignment="CENTER_LEFT"/>
                                    </StackPane>
                                </VBox>

                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="DESCARGA ACTUAL" styleClass="progress-head-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblDownloadPercent" text="0%" styleClass="progress-percent-label"/>
                                    </HBox>
                                    <StackPane fx:id="progressTrackDownload" styleClass="progress-track" prefHeight="8" prefWidth="390">
                                        <Region fx:id="progressFillDownload"
                                                styleClass="progress-fill, progress-fill-download"
                                                prefHeight="8"
                                                prefWidth="0"
                                                StackPane.alignment="CENTER_LEFT"/>
                                        <Region fx:id="progressIndDownload"
                                                styleClass="progress-indicator"
                                                prefWidth="74"
                                                prefHeight="6"
                                                StackPane.alignment="CENTER_LEFT"/>
                                    </StackPane>
                                </VBox>

                                <HBox fx:id="timerRow" prefWidth="390" alignment="CENTER_LEFT">
                                    <Label fx:id="lblTimer" styleClass="timer-label"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </StackPane>

                    <fx:include fx:id="login" source="login.fxml"/>
                </StackPane>
            </HBox>

            <AnchorPane pickOnBounds="false" maxWidth="Infinity" maxHeight="Infinity">
                <StackPane fx:id="notificationsAnchor"
                           pickOnBounds="false"
                           AnchorPane.topAnchor="16.0"
                           AnchorPane.rightAnchor="20.0">
                    <Button fx:id="btnNotifications"
                            styleClass="notification-bell-btn"
                            onAction="#onToggleNotifications"/>
                    <StackPane fx:id="notificationBadge"
                               styleClass="notification-badge"
                               visible="false"
                               managed="false"
                               mouseTransparent="true"
                               StackPane.alignment="TOP_RIGHT"
                               translateX="5"
                               translateY="-5">
                        <Label fx:id="lblNotificationCount"
                               text="0"
                               styleClass="notification-badge-label"/>
                    </StackPane>
                </StackPane>

                <StackPane fx:id="notificationsDropdown"
                           visible="false"
                           managed="false"
                           pickOnBounds="false"
                           AnchorPane.topAnchor="62.0"
                           AnchorPane.rightAnchor="16.0">
                    <StackPane prefWidth="334"
                               prefHeight="422"
                               maxWidth="334"
                               maxHeight="422"
                               styleClass="notifications-shell">
                        <ImageView fx:id="imgNotificationsBook"
                                   fitWidth="334"
                                   fitHeight="422"
                                   preserveRatio="false"
                                   smooth="false"/>
                        <BorderPane prefWidth="334"
                                    prefHeight="422"
                                    maxWidth="334"
                                    maxHeight="422">
                            <top>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <padding><Insets top="24" right="22" bottom="0" left="34"/></padding>
                                    <Label text="Notificaciones" styleClass="book-title"/>
                                    <Label fx:id="lblNotificationsHeaderCount" text="0" styleClass="book-count" visible="false" managed="false"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnCloseNotifications"
                                            text="X"
                                            styleClass="book-close-btn"
                                            onAction="#onCloseNotifications"/>
                                </HBox>
                            </top>
                            <center>
                                <ScrollPane fx:id="notificationsScroll"
                                            styleClass="notifications-scroll"
                                            fitToWidth="true"
                                            hbarPolicy="NEVER"
                                            vbarPolicy="AS_NEEDED">
                                    <BorderPane.margin><Insets top="10" right="20" bottom="26" left="30"/></BorderPane.margin>
                                    <content>
                                        <VBox fx:id="notificationsList"
                                              styleClass="notifications-list"
                                              spacing="8"
                                              maxWidth="Infinity"/>
                                    </content>
                                </ScrollPane>
                            </center>
                        </BorderPane>
                    </StackPane>
                </StackPane>

                <VBox fx:id="toastLayer"
                      pickOnBounds="false"
                      spacing="10"
                      alignment="TOP_RIGHT"
                      AnchorPane.bottomAnchor="78.0"
                      AnchorPane.rightAnchor="22.0"/>
            </AnchorPane>

            <StackPane fx:id="modalLayer" styleClass="modal-layer" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity"/>

            <StackPane fx:id="startupOverlay" styleClass="startup-overlay" maxWidth="Infinity" maxHeight="Infinity" visible="false" managed="false">
                <VBox alignment="CENTER" spacing="12" maxWidth="Infinity" maxHeight="Infinity">
                    <Label fx:id="lblStartupStatus" text="Cargando Launcher" styleClass="startup-title"/>
                    <StackPane fx:id="startupProgressTrack" styleClass="startup-progress-track" prefWidth="260" prefHeight="6" maxWidth="-Infinity">
                        <Region fx:id="startupProgressFill"
                                styleClass="startup-progress-fill"
                                prefHeight="6"
                                prefWidth="0"
                                StackPane.alignment="CENTER_LEFT"/>
                    </StackPane>
                    <Label fx:id="lblStartupPercent" text="0%" styleClass="startup-percent"/>
                </VBox>
            </StackPane>
        </StackPane>
    </center>

</BorderPane>
